target
# Coverage report produced by `just cov` (cargo-llvm-cov); CI re-generates it
# and uploads it as the `lcov` artifact.
lcov.info
.vscode
dist
.env
# Local DB tooling config (pgAdmin/DBeaver), contains dev connection details.
servers.json
.claude
# Python bytecode cache from the scripts/ tooling (just spec-code / contracts).
__pycache__/
*.pyc
# Scale corpora for the benches (`ambre-spec-fixtures.md`, `FIXTURE-022`).
# Multi-megabyte, minutes to build and fully reproducible from a seed, so
# `just fixtures-bench-corpus` writes them and git never carries them.
fixtures/bench/
# What `just fuzz` grows and finds (`fuzz/`). A crash worth keeping becomes a
# unit test beside its reader; the corpus regrows from nothing in seconds.
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/
