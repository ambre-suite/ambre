// ambre-canvas/tokens.ron
// ============================================================================
// SINGLE SOURCE of Ambre's design tokens (ambre-spec-design-tokens.md).
// `just tokens-write` reads this file and generates BOTH, committed in src/:
//   - theme.css    : CSS custom properties for the DOM chrome (ambre-chrome).
//   - theme_gen.rs : Rust `Palette` constants for the wgpu content (ambre-canvas).
// `just tokens-check` fails when either one is not what this file generates.
// One source => canvas/DOM coherence by construction. Light is the unmarked
// `:root` default; dark is `:root[data-theme="dark"]` and the canvas DARK palette.
//
// Colours are `#rrggbb`; an effect or photo colour may carry an alpha, `#rrggbbaa`.
// Scales are unitless integers (px for CSS, f32 for Rust).
// ============================================================================
Tokens(
    // -- Chrome (DOM) colours -> CSS custom properties ------------------------
    chrome: (
        light: (
            // The warm palette of the shared chrome mockup
            // (`research/mockups/shared-chrome.html`), adopted on 2026-11-21.
            bg:        "#f6f4f0",
            surface:   "#ffffff",
            surface_2: "#efece6",
            surface_hover: "#e7e3dc",
            border:    "#e3ddd3",
            // A shade darker than the mockup's strong line, so the border of
            // a control reads on the sunken ground: about 2:1, not 1.4:1.
            border_strong: "#bdb3a4",
            text:      "#1f1b16",
            text_dim:  "#6f675c",
            text_faint: "#9a9184",
            accent:    "#b45309",
            accent_soft: "#f6e3d1",
            success:   "#2b9d6a",
            warning:   "#c2410c",
            error:     "#cc4444",
            info:      "#2467c0",
            on_accent: "#ffffff",
        ),
        dark: (
            bg:        "#13110e",
            surface:   "#1d1a16",
            surface_2: "#171511",
            surface_hover: "#2a2620",
            border:    "#312c25",
            // About 2.3:1 on the surface, for the border of a control.
            border_strong: "#5a5145",
            text:      "#eee8df",
            text_dim:  "#a59a89",
            text_faint: "#7b7266",
            accent:    "#f2a93d",
            accent_soft: "#3a2614",
            success:   "#4ad295",
            warning:   "#e8772e",
            error:     "#e05a5a",
            info:      "#5a9ae0",
            // The dark accent is light, so the text on it is dark.
            on_accent: "#1b1b1d",
        ),
    ),

    // -- Chrome effects -> CSS custom properties, one set per theme ----------
    // A shadow is a vertical offset, a blur and a colour. The light theme
    // casts softer ones: a dark shadow on a light ground reads heavier.
    effects: (
        light: (
            shadow_low:  (y: 1,  blur: 4,  colour: "#0000001f"),
            shadow_mid:  (y: 4,  blur: 14, colour: "#0000002e"),
            shadow_high: (y: 12, blur: 48, colour: "#00000047"),
            scrim:       "#0a0a1473",
        ),
        dark: (
            shadow_low:  (y: 1,  blur: 4,  colour: "#0000001f"),
            shadow_mid:  (y: 4,  blur: 14, colour: "#00000059"),
            shadow_high: (y: 12, blur: 48, colour: "#0000008c"),
            scrim:       "#0a0a1473",
        ),
    ),

    // -- Colours drawn over a picture -> CSS, the same in both themes --------
    // The ground is the picture, not the theme, so these do not switch.
    photo: (
        text:           "#ffffff",
        text_shadow:    "#000000bf",
        line:           "#ffffff1f",
        control_line:   "#ffffff80",
        control_ground: "#ffffff29",
        veil:           "#120c05d1",
        veil_deep:      "#120c05eb",
    ),

    // -- Canvas (wgpu content) colours -> Rust Palette -----------------------
    // The warm palette of the chrome: a grid and its headers read the same
    // surfaces, lines and dimmed text as the DOM beside them.
    canvas: (
        light: (
            content_bg:      "#ffffff",
            content_pending: "#f6f4f0",
            header_bg:       "#efece6",
            header_active:   "#f6e3d1",
            header_hover:    "#e7e3dc",
            grid_line:       "#e3ddd3",
            header_border:   "#cfc7ba",
            selection:       "#b06f0a",
            cell_text:       "#202020",
            // A shade darker than the chrome's dimmed text, so a header label
            // passes AA on the hovered and the active header too.
            header_text:     "#6a6257",
            caret:           "#141414",
            cell_error:      "#cc4444",
            cell_border:     "#606060",
            // The chrome's sunken surface, around a page and under a board.
            ground:          "#efece6",
            grid_dot:        "#cfc7ba",
            shadow:          "#1f1b16",
        ),
        dark: (
            content_bg:      "#1d1a16",
            content_pending: "#13110e",
            header_bg:       "#171511",
            header_active:   "#3a2614",
            header_hover:    "#2a2620",
            grid_line:       "#312c25",
            header_border:   "#453e35",
            selection:       "#f2a93d",
            cell_text:       "#e8e8e8",
            header_text:     "#a59a89",
            caret:           "#f0f0f0",
            cell_error:      "#e05a5a",
            cell_border:     "#8c8c94",
            ground:          "#171511",
            grid_dot:        "#453e35",
            shadow:          "#000000",
        ),
    ),

    // -- Theme-independent scales (px in CSS, f32 in Rust) -------------------
    // A spacing steps by two pixels, `space_n` being `2n`. Every padding,
    // margin and gap of the shell reads one; a hairline of 1px is a border
    // width, not a spacing.
    scale: [
        ("space_1",         2),
        ("space_2",         4),
        ("space_3",         6),
        ("space_4",         8),
        ("space_5",         10),
        ("space_6",         12),
        ("space_7",         14),
        ("space_8",         16),
        ("space_10",        20),
        ("space_11",        22),
        ("space_12",        24),
        ("space_13",        26),
        ("space_14",        28),
        ("space_20",        40),
        ("space_24",        48),
        ("radius_sm",       4),
        ("radius",          6),
        ("radius_md",       8),
        ("radius_lg",       12),
        ("radius_full",     999),
        ("font_xs",         11),
        ("font_small",      12),
        ("font_ui",         13),
        ("font_body",       14),
        ("font_subheading", 15),
        ("font_large",      16),
        ("font_heading",    20),
        ("font_display",    26),
        ("font_hero",       32),
        // The height of a control: a field, a select, a button. A row of
        // the panel holds the middle one; a dense list the small one.
        ("control_sm",      24),
        ("control",         28),
        ("control_lg",      32),
        // The box an icon glyph is drawn in, inside its control.
        ("icon_sm",         14),
        ("icon",            16),
        ("icon_lg",         20),
        // The keyboard focus ring: its width, and its gap to the control.
        ("focus_width",     2),
        ("focus_offset",    2),
    ],
)
