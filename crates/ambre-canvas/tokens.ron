// ambre-canvas/tokens.ron
// ============================================================================
// SINGLE SOURCE of Ambre's design tokens (ambre-spec-design-tokens.md). `build.rs` reads
// this file and generates BOTH:
//   - theme.css : CSS custom properties for the DOM chrome (ambre-chrome).
//   - theme.rs  : Rust `Palette` constants for the wgpu content (ambre-canvas).
// One source => canvas/DOM coherence by construction. Light is the unmarked
// `:root` default; dark is `:root[data-theme="dark"]` and the canvas DARK palette.
//
// Colours are `#rrggbb`. Scales are unitless integers (px for CSS, f32 for Rust).
// ============================================================================
Tokens(
    // -- Chrome (DOM) colours -> CSS custom properties ------------------------
    chrome: (
        light: (
            bg:        "#f8f9fa",
            surface:   "#ffffff",
            surface_2: "#f0f1f3",
            surface_hover: "#e6e8ec",
            border:    "#d8dade",
            text:      "#1f1f1f",
            text_dim:  "#5f6368",
            accent:    "#b45309",
            success:   "#2b9d6a",
            warning:   "#c2410c",
            error:     "#cc4444",
            info:      "#2467c0",
        ),
        dark: (
            bg:        "#1b1b1d",
            surface:   "#242427",
            surface_2: "#2c2c30",
            surface_hover: "#35353b",
            border:    "#3a3a3f",
            text:      "#e8e8e8",
            text_dim:  "#9aa0a6",
            accent:    "#f2a93d",
            success:   "#4ad295",
            warning:   "#e8772e",
            error:     "#e05a5a",
            info:      "#5a9ae0",
        ),
    ),

    // -- Canvas (wgpu content) colours -> Rust Palette -----------------------
    canvas: (
        light: (
            content_bg:      "#ffffff",
            content_pending: "#ebedf0",
            header_bg:       "#f2f3f5",
            header_active:   "#f5e7c8",
            header_hover:    "#e6e8ec",
            grid_line:       "#d2d5da",
            header_border:   "#b8bcc4",
            selection:       "#b06f0a",
            cell_text:       "#202020",
            header_text:     "#5f6368",
            caret:           "#141414",
            cell_error:      "#cc4444",
        ),
        dark: (
            content_bg:      "#1c1c1f",
            content_pending: "#262629",
            header_bg:       "#2c2c30",
            header_active:   "#3d3420",
            header_hover:    "#35353b",
            grid_line:       "#37373c",
            header_border:   "#44444a",
            selection:       "#f2a93d",
            cell_text:       "#e8e8e8",
            header_text:     "#9aa0a6",
            caret:           "#f0f0f0",
            cell_error:      "#e05a5a",
        ),
    ),

    // -- Theme-independent scales (px in CSS, f32 in Rust) -------------------
    scale: (
        space_xs:     4,
        space_sm:     8,
        space_md:     12,
        space_lg:     16,
        radius:       6,
        font_small:   12,
        font_body:    14,
        font_heading: 20,
    ),
)
